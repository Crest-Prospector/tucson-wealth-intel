// Vercel Serverless Function — proxies HERE Places API
module.exports = async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS');
  if (req.method === 'OPTIONS') { res.status(200).end(); return; }

  const { at, radius = 2000, limit = 100 } = req.query;
  if (!at) return res.status(400).json({ error: 'Missing at parameter' });

  const HERE_KEY = process.env.HERE_KEY || '';
  if (!HERE_KEY) return res.status(503).json({ error: 'HERE_KEY not set in environment' });

  try {
    const url = `https://browse.search.hereapi.com/v1/browse?at=${at}&radius=${radius}&limit=${limit}&categories=100,200,300,400,500,600,700&apiKey=${HERE_KEY}`;
    const resp = await fetch(url);
    if (!resp.ok) return res.status(resp.status).json({ error: await resp.text() });
    res.status(200).json(await resp.json());
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};
